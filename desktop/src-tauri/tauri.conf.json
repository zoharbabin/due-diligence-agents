{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Due Diligence Agents",
  "version": "0.0.0",
  "identifier": "com.zoharbabin.due-diligence-agents",
  "build": { "frontendDist": "./splash" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Due Diligence Agents",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0QzhDMTYyRDUzODVFREUKUldUZVhqalZZc0hJTk5jbjdQcFVvMG0yNEkxei9ZbXpFZ09RUjVxY0dwUmFUSHlrWXVrZEV1dVIK",
      "endpoints": ["https://github.com/zoharbabin/due-diligence-agents/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "Business",
    "resources": {
      "resources/python": "python",
      "resources/runtime-packages.txt": "runtime-packages.txt",
      "../ui/dist": "ui"
    },
    "shortDescription": "Forensic M&A due diligence on your own machine",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
